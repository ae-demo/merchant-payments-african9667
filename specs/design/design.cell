title Merchant Payments Africa

component merchant-webapp as "Merchant Portal" web-application
component admin-webapp as "Admin Console" web-application
component checkout-webapp as "Hosted Checkout" web-application
component payments-api as "Payments API" service
component payments-db as "Payments Database" database

east thunder-auth as "Thunder Auth" identity-server
south internal-payments-api as "Internal Payments API" service
south sms-service as "SMS Service" service
south email-service as "Email Service" service

north -> merchant-webapp
north -> checkout-webapp
west -> admin-webapp

merchant-webapp -> payments-api
merchant-webapp -> thunder-auth

admin-webapp -> payments-api
admin-webapp -> thunder-auth

checkout-webapp -> payments-api

payments-api -> thunder-auth
payments-api -> payments-db
payments-api -> internal-payments-api
payments-api -> sms-service
payments-api -> email-service
